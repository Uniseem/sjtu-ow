# Copy to .env for local production-like Docker runs.
# Local `manage.py` development uses sjtu_ow.settings.dev and does not need these.

DJANGO_SETTINGS_MODULE=sjtu_ow.settings.prod
DJANGO_SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=change-me-unused-until-encrypted-fields
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SITE_URL=http://localhost
DATABASE_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/media
GUNICORN_WORKERS=3
PRERENDER_ENABLED=false
MODERATION_API_KEY=
MODERATION_BASE_URL=
SENTRY_DSN=
EMAIL_ALLOWLIST=
CADDY_SITE_ADDRESS=http://localhost
DJANGO_SECURE_SSL_REDIRECT=false
