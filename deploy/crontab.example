# 宿主机 crontab（设计 16.5）。表中时间都是北京时间。
# 海外服务器的系统时区通常不是北京时间，所以显式声明 CRON_TZ；
# 系统的 cron 不支持 CRON_TZ 时，把下面的小时换算成服务器时区。
#
#   crontab -l > /tmp/cron && cat deploy/crontab.example >> /tmp/cron && crontab /tmp/cron

CRON_TZ=Asia/Shanghai
COMPOSE=/srv/sjtu-ow/deploy/docker-compose.yml

# 每天 03:00 备份数据库和上传文件，保留最近 14 天（设计 16.7）
# 备份文件未加密，里面有用户邮箱和联系方式；同步到服务器以外之前要先加密。
0 3 * * * docker compose -f $COMPOSE exec -T web python manage.py backup

# 每天 04:00 清理过期数据：
#   API 调用日志 90 天、Webhook 投递记录 180 天、已完成任务记录 30 天、过期会话
0 4 * * * docker compose -f $COMPOSE exec -T web python manage.py cleanup_old_data

# 每天 04:15 全量重新生成预渲染页面
15 4 * * * docker compose -f $COMPOSE exec -T web python manage.py prerender

# 每天 04:20 清理 static 数据卷里不属于当前版本、且超过 30 天的旧文件
20 4 * * * docker compose -f $COMPOSE exec -T web python manage.py cleanup_static

# 每周日 04:30 SQLite PRAGMA optimize
30 4 * * 0 docker compose -f $COMPOSE exec -T web python manage.py optimize_db

# 每 10 分钟扫一次到期但没被执行的 Webhook 投递（019 的兜底，防止延时任务丢了）
*/10 * * * * docker compose -f $COMPOSE exec -T web python manage.py shell -c "from integrations.tasks import deliver_due_webhooks; deliver_due_webhooks.enqueue()"

# 每天 09:30 AI 审核的每日汇总邮件
30 9 * * * docker compose -f $COMPOSE exec -T web python manage.py moderate_scan --digest

# 说明：把备份同步到对象存储（设计 16.7 第 3 步）需要凭据，还没有做成命令。
# 现在要自己加一条，例如（先用 age 加密再上传）：
# 10 3 * * * age -r <公钥> -o /tmp/b.age /var/lib/docker/volumes/..._backups/_data/$(ls -t ... | head -1) && <上传命令>
