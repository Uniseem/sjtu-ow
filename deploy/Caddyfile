{
	admin off
}

{$CADDY_SITE_ADDRESS:localhost} {
	encode gzip zstd

	handle_errors {
		@backend expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
		handle @backend {
			rewrite * /maintenance.html
			root * /srv/error_pages
			header Cache-Control "no-store"
			file_server
		}
	}

	@hashed_static path_regexp hashed_static ^/static/.+\.[a-f0-9]{12}\.[^/]+$
	handle @hashed_static {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server {
			precompressed br gzip
		}
	}

	handle /media/* {
		root * /srv
		file_server
	}

	@always_django path /admin/* /admin /api/* /api /accounts/* /accounts /me/* /me /_fragments/* /_fragments /healthz /healthz/
	handle @always_django {
		reverse_proxy web:8000
	}

	@not_get_head not method GET HEAD
	handle @not_get_head {
		reverse_proxy web:8000
	}

	@has_query expression `{query} != ""`
	handle @has_query {
		reverse_proxy web:8000
	}

	@prerendered {
		file {
			root /srv/prerendered
			try_files {path}/index.html
		}
	}
	handle @prerendered {
		root * /srv/prerendered
		rewrite * {path}/index.html
		header Cache-Control "public, max-age=0, must-revalidate"
		file_server {
			precompressed br gzip
		}
	}

	handle {
		reverse_proxy web:8000
	}
}
