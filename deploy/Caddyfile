{
	admin off
}

# What Django sends with every page it renders (design 13.13.2, v6.3). The
# policy must match SECURE_CSP word for word; a test compares the two.
(page_security) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'inline-speculation-rules'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self' https://player.bilibili.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
	}
}

# Every request Django answers goes through here (round 120). Caddy tells
# Django who the visitor is: {client_ip} honours trusted_proxies (a reverse
# proxy in front, see Caddyfile.vps on the demo server), and header_up
# replaces any X-Real-IP the visitor sent. Django's own REMOTE_ADDR is only
# this container, so without it every visitor shared one rate limit.
(django) {
	reverse_proxy web:8000 {
		header_up X-Real-IP {client_ip}
	}
}

{$CADDY_SITE_ADDRESS:localhost} {
	# Compressed on the fly (design 13.10, v6.3). Caddy 2.10's precompressed
	# answers 206 Partial Content to requests that asked for no range, so
	# the .br/.gz files next to static and prerendered files go unused.
	encode zstd gzip

	handle_errors {
		@backend expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
		handle @backend {
			rewrite * /maintenance.html
			root * /srv/error_pages
			header Cache-Control "no-store"
			file_server
		}
	}

	@hashed_static path_regexp hashed_static ^/static/.+\.[a-f0-9]{12}\.[^/]+$
	handle @hashed_static {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	# Font slices and the generated font stylesheet carry a content hash.
	@hashed_fonts path_regexp hashed_fonts ^/media/fonts/(css/fonts\.[a-f0-9]{12}\.css|[0-9]+/[^/]+\.woff2)$
	handle @hashed_fonts {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Thumbnails are named after the original's file name and the crop, so
	# a new picture always gets a new address (design 13.10, v6.3).
	handle /media/images/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		file_server
	}

	@always_django path /admin/* /admin /accounts/* /accounts /me/* /me /_fragments/* /_fragments /healthz /healthz/
	handle @always_django {
		import django
	}

	@not_get_head not method GET HEAD
	handle @not_get_head {
		import django
	}

	@has_query expression `{query} != ""`
	handle @has_query {
		import django
	}

	@prerendered {
		file {
			root /srv/prerendered
			try_files {path}/index.html
		}
	}
	handle @prerendered {
		root * /srv/prerendered
		rewrite * {path}/index.html
		header Cache-Control "public, max-age=0, must-revalidate"
		import page_security
		file_server
	}

	handle {
		import django
	}
}
