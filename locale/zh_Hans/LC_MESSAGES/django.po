msgstr "按钮没有文字"

msgid "Input button text is empty"
msgstr "输入按钮没有文字"

msgid "Link text is empty"
msgstr "链接没有文字"

msgid "Use meaningful text for screen reader users"
msgstr "写上有意义的文字，方便用读屏软件的人"

