# 编辑页：自动保存、侧栏
msgid "Saved"
msgstr "已保存"

msgid "Autosave is paused"
msgstr "自动保存已暂停"

msgid "Autosave is <span>paused</span>"
msgstr "自动保存<span>已暂停</span>"

msgid "A network error occurred"
msgstr "网络出错了"

msgid ""
"Troubleshoot your connection to the site before proceeding. Open the editor "
"in a separate tab to view the last saved version."
msgstr "请先检查和网站的连接再继续。可以在新标签页里打开编辑页，看最后一次保存的版本。"

msgid "View latest version"
msgstr "查看最新版本"

msgid "Locking: "
msgstr "锁定："

msgid "Anyone can edit this %(model_name)s"
msgstr "任何人都能编辑这个%(model_name)s"

msgid ""
"Anyone can edit this %(model_name)s – lock it to prevent others from editing"
msgstr "任何人都能编辑这个%(model_name)s，锁定后别人就不能改了"

msgid "Choose who can view the live version of this page"
msgstr "选择谁能看到这个页面已发布的版本"

msgid "Choose when this %(model_name)s should go live and/or expire"
msgstr "选择这个%(model_name)s什么时候上线、什么时候过期"

msgid "Choose when this page should go live and/or expire"
msgstr "选择这个页面什么时候上线、什么时候过期"

msgid ""
