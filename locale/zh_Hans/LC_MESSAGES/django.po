# 项目自己补的后台中文翻译（117 轮）。
#
# Wagtail 8 的简体中文翻译缺了一百多条，后台到处是英文。这里只放 Wagtail
# 没翻译的原文（逐页渲染后台、记下查不到译文的字符串得来的），外加两条
# 「帐号」改成全站统一的「账号」。原文必须和 Wagtail 源码一字不差。
# 改完运行 `uv run python manage.py compile_translations`，把 .mo 一起提交。
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# 全站统一写「账号」（Wagtail 原译「帐号」）
msgid "Account"
msgstr "账号"

msgid "Your account settings have been changed successfully!"
msgstr "账号设置已保存。"

# 页面树、列表
msgid "Exploring"
msgstr "正在浏览"

msgid "Sort by '%(label)s' in ascending order."
msgstr "按「%(label)s」升序排列。"

msgid "Sort by '%(label)s' in descending order."
msgstr "按「%(label)s」降序排列。"

msgid "Date updated"
msgstr "更新时间"

msgid "Edited by"
msgstr "编辑人"

msgid "Has child pages"
msgstr "有子页面"

msgid "Page type"
msgstr "页面类型"

msgid "Any"
msgstr "不限"

msgid ""
"The root level is where you can add new sites to your Wagtail installation. "
"Pages created here will not be accessible at any URL until they are "
"associated with a site."
msgstr "根层级用来添加新的站点。在这里创建的页面要关联到一个站点之后才能通过网址访问。"

msgid ""
"If you just want to add pages to an existing site, create them as children "
"of the homepage instead."
msgstr "如果只是想给现有站点加页面，请在首页下面创建。"

msgid "%(start_index)s-%(end_index)s of %(items_count)s %(model_name)s"
msgstr "第 %(start_index)s–%(end_index)s 条，共 %(items_count)s 条%(model_name)s"

msgid ""
"There are no %(model_name)s to display. Why not <a href=\"%(add_url)s\">add "
"one</a>?"
msgstr "还没有%(model_name)s，<a href=\"%(add_url)s\">现在添加</a>。"

msgid "New: %(model_name)s"
msgstr "新建%(model_name)s"

msgid "Actions (footer)"
msgstr "操作（底部）"

msgid "Go to the first error"
msgstr "跳到第一个错误"

msgid "Compare"
msgstr "比较"

msgid "%(time)s by %(user_display_name)s"
msgstr "%(user_display_name)s 于 %(time)s"

msgid "%(time_period)s ago by %(user_display_name)s"
msgstr "%(user_display_name)s 于 %(time_period)s前"

msgid "To be created by %(user)s"
msgstr "将由 %(user)s 创建"

msgid "This %(model_name)s is referenced %(usage_count)s time."
msgid_plural "This %(model_name)s is referenced %(usage_count)s times."
msgstr[0] "这个%(model_name)s被引用了 %(usage_count)s 次。"

msgid "Referenced %(count)s time"
msgid_plural "Referenced %(count)s times"
msgstr[0] "被引用 %(count)s 次"

# 后台首页
msgid "Search all pages…"
msgstr "搜索全部页面…"

msgid ""
"%(total)s Page <span class=\"w-sr-only\">created in %(site_name)s</span>"
msgid_plural ""
"%(total)s Pages <span class=\"w-sr-only\">created in %(site_name)s</span>"
msgstr[0] "%(total)s 个页面<span class=\"w-sr-only\">（%(site_name)s）</span>"

msgid ""
"%(total)s Image <span class=\"w-sr-only\">created in %(site_name)s</span>"
msgid_plural ""
"%(total)s Images <span class=\"w-sr-only\">created in %(site_name)s</span>"
msgstr[0] "%(total)s 张图片<span class=\"w-sr-only\">（%(site_name)s）</span>"

msgid ""
"%(total)s Document <span class=\"w-sr-only\">created in %(site_name)s</span>"
msgid_plural ""
"%(total)s Documents <span class=\"w-sr-only\">created in %(site_name)s</span>"
msgstr[0] "%(total)s 个文档<span class=\"w-sr-only\">（%(site_name)s）</span>"

msgid "Edit account avatar"
msgstr "账号设置"

msgid "Wagtail %(current_version)s editor guide"
msgstr "Wagtail %(current_version)s 编辑指南"

msgid "Wagtail upgrade available"
msgstr "Wagtail 有新版本"

msgid ""
"Your version: <strong>%(current_version)s</strong>. New version: <strong "
"data-w-upgrade-target=\"latestVersion\"></strong>."
msgstr ""
"当前版本：<strong>%(current_version)s</strong>。新版本：<strong data-w-"
"upgrade-target=\"latestVersion\"></strong>。"

msgid "Read the release notes."
msgstr "查看更新说明。"

msgid ""
"JavaScript is required to use Wagtail, but it is currently disabled.<br /> "
"Here are the <a href=\"https://www.enable-javascript.com/\" target=\"_blank\" "
"rel=\"noreferrer\">instructions how to enable JavaScript in your web "
"browser</a>."
msgstr ""
"后台需要 JavaScript，但浏览器现在禁用了它。<br /> 可以参考<a href=\"https://"
"www.enable-javascript.com/\" target=\"_blank\" rel=\"noreferrer\">在浏览器里"
"启用 JavaScript 的方法</a>。"

