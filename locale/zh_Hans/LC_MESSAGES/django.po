msgstr "写上有意义的文字"

msgid "Empty heading found"
msgstr "有空的标题"

msgid "Table header text is empty"
msgstr "表头没有文字"

msgid "Empty frame title found"
msgstr "有没写标题的内嵌框架"

msgid "Use a meaningful title for screen reader users"
msgstr "写上有意义的标题，方便用读屏软件的人"

msgid "Incorrect heading hierarchy"
msgstr "标题层级不对"

msgid "Avoid skipping levels"
msgstr "不要跳级"

msgid "Misusing paragraphs as headings"
msgstr "把段落当标题用了"

msgid "Use proper heading tags"
msgstr "请用标题格式"

msgid "Image alt text has inappropriate pattern"
msgstr "图片说明的写法不合适"

msgid "Meta description is empty"
msgstr "页面描述是空的"

msgid "Add a concise description for search engines"
msgstr "给搜索引擎写一句简短的描述"

# 页面的访问权限
msgid "Private, accessible with a shared password"
msgstr "不公开，凭共享密码访问"

msgid "Private, accessible to any logged-in users"
msgstr "不公开，登录的人都能访问"

msgid ""
"Shared passwords should not be used to protect sensitive content. Anyone who "
