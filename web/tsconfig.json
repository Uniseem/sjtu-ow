{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@sjtu-ow/api": [
        "./packages/api/src/index.ts"
      ],
      "@sjtu-ow/ui/*.vue": [
        "./packages/ui/src/*.vue"
      ],
      "@sjtu-ow/ui/*": [
        "./packages/ui/src/*.ts"
      ],
      "@sjtu-ow/shared/*": [
        "./packages/shared/src/*.ts"
      ]
    }
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": [
      "data-*"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.vue",
    "packages/**/*.ts",
    "packages/**/*.vue"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
